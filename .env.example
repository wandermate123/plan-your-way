# SQLite database file is created relative to the prisma/ folder.
DATABASE_URL="file:../data/bookings.db"

# Same value in Authorization: Bearer <secret> for /api/admin/pricing
ADMIN_PRICING_SECRET="replace-with-long-random-string"

# Google Gemini — powers /api/travel-assistant (optional; UI shows a clear error if unset)
# Create a key in Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Model id for v1beta (no "models/" prefix), e.g. gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL="gemini-2.0-flash"
