# SQLite database file is created relative to the prisma/ folder.
DATABASE_URL="file:../data/bookings.db"

# Same value in Authorization: Bearer <secret> for /api/admin/pricing
ADMIN_PRICING_SECRET="replace-with-long-random-string"

# OpenAI — powers /api/travel-assistant (optional; UI shows a clear error if unset).
# Prefer `.env.local` for secrets (gitignored); `.env` in the project root also works.
OPENAI_API_KEY=""
# e.g. gpt-4o-mini, gpt-4o
OPENAI_MODEL="gpt-4o-mini"
# Optional: default is https://api.openai.com/v1 (no trailing slash)
# OPENAI_BASE_URL="https://api.openai.com/v1"
# Optional: per-request timeout to OpenAI in ms (default 11000; avoids host 502 on slow hangs)
# OPENAI_FETCH_TIMEOUT_MS=11000

# --- Public API rate limits (per IP, in-memory; tune per environment) ---
# Window length in ms (default 60000)
# RATE_LIMIT_WINDOW_MS=60000
# Max requests per window (defaults shown)
# RATE_LIMIT_QUOTE_MAX=30
# RATE_LIMIT_QUOTE_OPTIONS_MAX=60
# RATE_LIMIT_TRAVEL_ASSISTANT_MAX=15
# RATE_LIMIT_BOOKING_MAX=12
